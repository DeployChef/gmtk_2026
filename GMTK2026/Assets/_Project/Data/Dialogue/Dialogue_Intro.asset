  m_Script: {fileID: 11500000, guid: d1a109ef1def001a2b3c4d5e6f708192, type: 3}
  m_Name: Dialogue_Intro
  m_EditorClassIdentifier: TheyWillDescend.Core::TheyWillDescend.Core.Dialogue.DialogueDefinition
  id: intro
  lines:
  - text: The gods are angry with us!
    portrait: {fileID: -7900349967275961828, guid: 28ad4c5995e87314483908ce98e7431a, type: 3}
  - text: "They demand offerings \u2014 gifts for their altar."
    portrait: {fileID: -7900349967275961828, guid: 28ad4c5995e87314483908ce98e7431a, type: 3}
  - text: Refuse them, and it is the end of the world!
    portrait: {fileID: -7900349967275961828, guid: 28ad4c5995e87314483908ce98e7431a, type: 3}
