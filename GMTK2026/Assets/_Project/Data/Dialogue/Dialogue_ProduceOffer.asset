  id: produce_offer
  defaultPortrait: {fileID: -4451315519708527431, guid: 9ab23bf8659655745b73bdd7fd4dd389, type: 3}
  lines:
  - text: "Produce resources \u2014 food, wood, stone, and more."
    portrait: {fileID: -4451315519708527431, guid: 9ab23bf8659655745b73bdd7fd4dd389, type: 3}
  - text: Then drag your offerings to the pyramid.
    portrait: {fileID: -4451315519708527431, guid: 9ab23bf8659655745b73bdd7fd4dd389, type: 3}
  - text: Feed the altar, or the gods will end us all!
    portrait: {fileID: -4451315519708527431, guid: 9ab23bf8659655745b73bdd7fd4dd389, type: 3}
